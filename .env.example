# OrchardVision environment configuration
# Copy to `.env` and adjust as needed. Never commit `.env`.

# --- Application ---
APP_NAME=OrchardVision API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false

# --- Security ---
SECRET_KEY=change-me-to-a-random-string
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Whether CORS responses may include credentials
CORS_ALLOW_CREDENTIALS=true

# --- Database ---
# SQLite (local development):
DATABASE_URL=sqlite:///./data/orchardvision.db
# PostgreSQL (production/docker):
# DATABASE_URL=postgresql+psycopg://orchard:orchard@localhost:5432/orchardvision

# --- Storage ---
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed

# --- Upload limits ---
# 2 GB default
MAX_UPLOAD_BYTES=2147483648
# Comma-separated list of accepted video MIME types
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/quicktime,video/x-msvideo,video/webm,video/mpeg

# --- Processing ---
DEFAULT_INFERENCE_MODE=mock
DEFAULT_CONFIDENCE_THRESHOLD=0.35
DEFAULT_REID_THRESHOLD=0.6
DEFAULT_MEMORY_UPDATE_RATE=0.2
DEFAULT_TRACKER_MATCH_THRESHOLD=120.0
DEFAULT_TRACKER_BUFFER_FRAMES=30
AUTO_CREATE_TABLES=true

# --- Job queue ---
# Leave CELERY_BROKER_URL unset to process jobs in-process (local development).
# Set it (plus a Redis, see docker-compose.yml) for a Celery worker deployment:
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# CELERY_TASK_ALWAYS_EAGER=false

# --- Optional: real model paths (do not commit weights) ---
# Defaults to models/mango_yolov8n-4/weights/best.pt relative to the repo root.
# YOLO_WEIGHTS_PATH=/path/to/yolo.pt
# Trained identity embedder (output of scripts/train_identity_embedder.py). When
# set, real-mode inference uses it; otherwise the pretrained torchvision
# backbone runs.
# EMBEDDING_MODEL_PATH=/path/to/embedding.pt
# TAPNext++ point-tracker weights (scripts/download_tapnext_weights.py). Only
# needed when processing with tracker=tapnext; the API process must also have
# the ml `tapnext` extra installed.
# TAPNEXT_CHECKPOINT_PATH=/path/to/tapnextpp_ckpt.pt

# --- Frontend (Vite) ---
# VITE_API_URL=/api